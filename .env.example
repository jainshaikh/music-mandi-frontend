# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never put backend secrets in NEXT_PUBLIC_* variables.

# Base URL of the backend API this frontend talks to.
NEXT_PUBLIC_API_BASE_URL=

# Public URL this frontend is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Interim SendGrid email integration for the contact / artist-submit /
# campaign-submit forms, while the real backend doesn't exist yet.
# See docs/DECISIONS.md DEC-017. Server-only — never prefix with NEXT_PUBLIC_.
SENDGRID_API_KEY=
# Must be a sender or domain verified in your SendGrid account.
SENDGRID_FROM_EMAIL=
CONTACT_TO_EMAIL=
ARTIST_TO_EMAIL=
ADS_TO_EMAIL=

# Interim Spotify artist-name autocomplete on /artists/submit, while the
# real backend doesn't exist yet. See docs/DECISIONS.md DEC-018. Client
# Credentials flow — create an app at https://developer.spotify.com/dashboard
# and use its Client ID/Secret. Server-only — never prefix with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
